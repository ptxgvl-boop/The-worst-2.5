-- Utility: Character
-- ============================================
local __cache = setmetatable({}, { __mode = "k" })

local function Char(arg)
    arg = arg or LocalPlayer
    if __cache[arg] then
        local c = __cache[arg].Character
        local r = __cache[arg].RootPart
        local h = __cache[arg].Humanoid
        if c and c.Parent and r and r.Parent and h and h.Parent then
            return c, r, h
        end
        __cache[arg] = nil
    end
    local character = arg.Character
    if character then
        local hrp = character:FindFirstChild("realHrp") or character:FindFirstChild("HumanoidRootPart")
        local hum = character:FindFirstChild("Humanoid")
        __cache[arg] = { Character = character, RootPart = hrp, Humanoid = hum }
        return character, hrp, hum
    end
end

