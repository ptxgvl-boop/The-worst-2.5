local C = {
    Text  = 'rgb(232, 230, 242)',
    Sub   = 'rgb(155, 153, 172)',
    Muted = 'rgb(90, 88, 105)',
    Faint = 'rgb(52, 50, 66)',
    Green = 'rgb(110, 210, 130)',
    Amber = 'rgb(220, 175, 80)',
    Red   = 'rgb(215, 75, 75)',
    Blue  = 'rgb(110, 165, 240)',
}
local function Col(text, colour) return ("<font color='%s'>%s</font>"):format(colour, text) end
local function Bold(text) return '<b>' .. text .. '</b>' end
local function Sep() return Col(('\u{2500}'):rep(20), C.Faint) end
local function Row(key, val, valCol)
    return Bold(key) .. Col('   ', C.Faint) .. Col(val, valCol or C.Sub)
end
local function Typewrite(label, finalText, speed)
    speed = speed or 0.04
    task.spawn(function()
        local plain = finalText:gsub('<[^>]+>', '')
        for i = 1, #plain do
            label:SetText(plain:sub(1, i))
            task.wait(speed)
        end
        label:SetText(finalText)
    end)
end
local function Cascade(fns, gap)
    gap = gap or 0.1
    task.spawn(function()
        for _, f in ipairs(fns) do f(); task.wait(gap) end
    end)
end
local function FormatUptime(s)
    local h = s // 3600
    local m = (s % 3600) // 60
    local sc = s % 60
    if h > 0 then return ('%dh %02dm'):format(h, m)
    elseif m > 0 then return ('%dm %02ds'):format(m, sc)
    else return sc .. 's' end
end

