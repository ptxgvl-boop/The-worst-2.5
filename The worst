        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
        if currentTrack then currentTrack:Stop() end
        local anim = Instance.new("Animation")
        anim.AnimationId = Animations[selectedAnim]
        currentTrack = animator:LoadAnimation(anim)
        currentTrack.Priority = Enum.AnimationPriority.Action
        currentTrack.Looped = true
        currentTrack:Play()
        currentTrack:AdjustSpeed(animSpeed)
    end

    MainR:CreateToggle({
        Name = "Play Animation",
        Flag = "AnimToggle",
        Default = false,
        Callback = function(v)
            animEnabled = v
            if v then playAnim()
            else
                if currentTrack then currentTrack:Stop() currentTrack = nil end
            end
        end,
    })
    MainR:CreateDropdown({
        Name = "Animation",
        Flag = "AnimSelect",
        Items = {"Crazy","Dab","Robot","Thriller","Moon Dance","Faint","Levitate"},
        Default = "Crazy",
        Callback = function(v)
            selectedAnim = v
            if animEnabled then playAnim() end
        end,
    })
    MainR:CreateSlider({
        Name = "Animation Speed",
        Flag = "AnimSpeed",
        Min = 0.1, Max = 10, Default = 1,
        Callback = function(v)
            animSpeed = v
            if currentTrack then currentTrack:AdjustSpeed(v) end
        end,
    })
end)()

