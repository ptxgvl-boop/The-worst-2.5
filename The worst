    Flag = "Inv_CAToggle",
    Callback = function(v)
        State.Toggles.CounterAttack = v
        if v then
            task.spawn(function()
                while State.Toggles.CounterAttack do
                    local char = LocalPlayer.Character
                    local head = char and char:FindFirstChild("Head")
                    local po = head and head:FindFirstChild("PartOwner")
                    if po and po.Value ~= "" and po.Value ~= LocalPlayer.Name then
                        local grabber = Players:FindFirstChild(po.Value)
                        if grabber and not IsProtectedPlayer(grabber) then
                            local method = State.Values.CounterMethod
                            if method == "Kill" then Actions.Kill(grabber)
                            elseif method == "Void" then Actions.Void(grabber)
                            elseif method == "Bring" then Actions.BringPlayer(grabber)
                            elseif method == "Delete Limbs" then Actions.BreakLimb(grabber, State.Values.TargetedLimbCA)
                            elseif method == "Remove Gucci" then Actions.RemoveGucci(grabber) end
                        end
                    end
                    task.wait(0.15)
                end
            end)
        end
    end,
})

