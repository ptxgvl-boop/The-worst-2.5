function playNotifySound()
    if notificationsMuted then return end
    local soundId = soundInput.Value
    if soundId and soundId ~= '' then
        if not string.find(soundId, 'rbxassetid://') and not string.find(soundId, 'http') then
            soundId = 'rbxassetid://' .. soundId
        end
        local sound = Instance.new('Sound')
        sound.SoundId = soundId; sound.Volume = notificationVolume; sound.Parent = workspace
        sound:Play(); game:GetService('Debris'):AddItem(sound, 3)
    end
end

function SendEventNotification(eventKey, title, description, icon, iconColor)
    if not notifiesEnabled or not enabledEvents[eventKey] then return end
    playNotifySound()
    Library:Notify({
        Title = title, Description = description, Icon = icon,
        Time = notifDuration or 4, IconColor = iconColor or Color3.fromRGB(255, 255, 255),
