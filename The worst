local function playNotificationSound()
    local sound = Instance.new("Sound")
    sound.SoundId = _G.TW_NotificationSoundId or "rbxassetid://129485210015224"
    sound.Volume = 1
    sound.Parent = game:GetService("SoundService")
    sound:Play()
    sound.Ended:Connect(function() sound:Destroy() end)
end

local function notify(title, content, duration)
    local payload
    if type(title) == "table" then
        payload = {}
        for k, v in pairs(title) do payload[k] = v end
        payload.Name    = payload.Name or payload.Title or "Notification"
        payload.Content = payload.Content or payload.Description or ""
        payload.Time    = payload.Time or payload.Duration or content or duration or 5
        payload.Image   = payload.Image or "bell"
    else
        payload = {
            Name = title or "Notification",
            Content = content or "",
            Time = duration or 5,
            Image = "bell",
        }
    end
    local ok, err = pcall(function()
        if type(Library.MakeNotification) == "function" then
            Library:MakeNotification(payload)
        end
    end)
    if ok then pcall(playNotificationSound)
    else warn("[TW 2.5 notify] " .. tostring(err)) end
end

