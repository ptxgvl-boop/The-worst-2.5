    Flag = "PlayerESP",
    Default = false,
    Callback = function(v)
        if _G.ESPConn then _G.ESPConn:Disconnect() _G.ESPConn = nil end
        if v then
            local function addESP(plr)
                if plr == LocalPlayer then return end
                local char = plr.Character
                if not char then return end
                if char:FindFirstChild("TW_ESP") then return end
                local h = Instance.new("Highlight")
                h.Name = "TW_ESP"
                h.Adornee = char
                h.FillColor = Color3.fromRGB(0, 170, 255)
                h.OutlineColor = Color3.fromRGB(255, 255, 255)
                h.FillTransparency = 0.4
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = char
            end
            for _, p in ipairs(Players:GetPlayers()) do addESP(p) end
            _G.ESPConn = Players.PlayerAdded:Connect(function(p)
                p.CharacterAdded:Connect(function() task.wait(0.5) addESP(p) end)
            end)
        else
            for _, p in ipairs(Players:GetPlayers()) do
                local char = p.Character
                if char then
                    local e = char:FindFirstChild("TW_ESP")
                    if e then e:Destroy() end
                end
            end
