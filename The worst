        ElementsTransparency = 0.3,
        SearchBar = true,
        ToggleUIKey = cfg.ToggleKeybind or cfg.ToggleKey or Enum.KeyCode.RightShift,
    })

    function window:CreateTab(name, enabled, icon)
        local tab = self:MakeTab({
            Name = name,
            Icon = (type(icon) == 'string' and icon) or 'circle',
        })
        function tab:CreateBlock(blockCfg)
            blockCfg = blockCfg or {}
            local section = tab:AddSection({
                Name = blockCfg.Name or 'Section',
                Side = blockCfg.Side or 'Left',
            })
            return _wrapBlock(section)
        end
        return tab
    end
    function window:SetFooter() end
    return window
end

