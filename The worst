local function IsNetworkOwner(part)
    if not (part and part:IsA("BasePart")) then return false end
    local root = part.AssemblyRootPart or part
    return not root.Anchored and root.ReceiveAge == 0
end

local function IsPartOwner(part)
    if not (part and part:IsA("BasePart")) then return false end
    local parent = part.Parent
    local head = part.Name == "HumanoidRootPart" and parent and parent:FindFirstChild("Head")
    head = head and head:FindFirstChild("PartOwner")
    if head and head.Value == LocalPlayer.Name then return true end
    local po = part:FindFirstChild("PartOwner")
    return po and po.Value == LocalPlayer.Name
end

local function IsProtectedPlayer(player, includeWhitelist)
    if State.TargetMethods.WhitelistedBypass and Lists.Whitelisted[player] then return true end
    return Lists.AdminImmune[player] == true
end

