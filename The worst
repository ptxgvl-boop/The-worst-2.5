    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 0, 0)
    stroke.Transparency = 0.15
    stroke.Thickness = 1.5
    stroke.Parent = frame

    local icon = Instance.new("ImageLabel")
    icon.BackgroundTransparency = 1
    icon.Position = UDim2.new(0, 15, 0, 5)
    icon.Size = UDim2.new(0, 27, 0, 27)
    icon.Image = "rbxassetid://108216966431078"
    icon.Parent = frame

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 56, 0, 0)
    label.Size = UDim2.new(1, -64, 1, 0)
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.RichText = true
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Parent = frame

    local hudTextHex = "#FFFFFF"
    local function colorToHex(c)
        return string.format("#%02X%02X%02X",
            math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
    end
    local function updateHudText(fps, ping)
        label.Text = string.format(
            "<font color='%s'><b>The Worst 2.5</b>  |  %d fps  |  %d ms</font>",
            hudTextHex, fps, ping)
    end
    updateHudText(60, 0)

    _G.TWPerformanceHUD = {
        Frame = frame, Stroke = stroke, Label = label, Corner = corner,
        SetTheme = function(theme)
            theme = theme or {}
            frame.BackgroundColor3 = theme.MainColor or Color3.fromRGB(8, 8, 12)
            stroke.Color = theme.OutlineColor or Color3.fromRGB(0, 0, 0)
            label.TextColor3 = theme.FontColor or Color3.fromRGB(255, 255, 255)
            hudTextHex = colorToHex(theme.FontColor or Color3.fromRGB(255, 255, 255))
        end,
        SetCornerRadius = function(value)
            corner.CornerRadius = UDim.new(0, math.clamp(tonumber(value) or 3, 0, 20))
        end,
    }

    local dragging, dragStart, startPosition, dragInput
    local inputService = game:GetService("UserInputService")
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPosition = true, input.Position, frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    inputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y)
        end
    end)

    local frames, frameTimer = 0, tick()
    local displayFPS, displayPing = 60, 0
    local targetFPS, targetPing = 60, 0
    local function easeOutQuad(t) return 1 - (1 - t) * (1 - t) end
    local function smooth(cur, tgt)
        local d = tgt - cur
        if math.abs(d) < 0.5 then return tgt end
        local s = d * (0.18 + easeOutQuad(math.min(1, math.abs(d) / 60)) * 0.35)
        if math.abs(s) < 1 and math.abs(d) > 2 then s = d > 0 and 1 or -1 end
        return cur + s
    end

    apexRunService.RenderStepped:Connect(function()
        if not gui.Parent then return end
        frames += 1
        if tick() - frameTimer >= 1 then
            targetFPS, frames, frameTimer = frames, 0, tick()
        end
        pcall(function()
            targetPing = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
    end)
    apexRunService.Heartbeat:Connect(function()
        if not gui.Parent then return end
        displayFPS = smooth(displayFPS, targetFPS)
        displayPing = smooth(displayPing, targetPing)
        updateHudText(math.floor(displayFPS + 0.5), math.floor(displayPing + 0.5))
    end)
end)

