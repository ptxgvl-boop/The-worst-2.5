-- Invincibility Loop: track grabber
-- ============================================
task.spawn(function()
    while task.wait(0.3) do
        local char = LocalPlayer.Character
        local head = char and char:FindFirstChild("Head")
        local po = head and head:FindFirstChild("PartOwner")
        if po and po.Value ~= "" then
            local grabber = Players:FindFirstChild(po.Value)
            if grabber and grabber ~= LocalPlayer then
                State.Values.WhoGrabbed = grabber.DisplayName .. " (@" .. grabber.Name .. ")"
                local lbl = Library.Flags and Library.Flags["Inv_LastGrabbed"]
                if lbl and lbl.SetText then
                    lbl:SetText("Last person who grabbed you: " .. State.Values.WhoGrabbed)
                end
            end
        end
    end
end)

