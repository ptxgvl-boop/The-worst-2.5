-- ============================================================
-- Adapter
-- ============================================================
local _usedControlFlags = {}
local function _flag(cfg)
    local base = tostring(cfg.Flag or cfg.Name or ('tw_' .. tostring(math.random(100000, 999999))))
    local flag, suffix = base, 2
    while _usedControlFlags[flag] or Library.Options[flag]
        or Library.Toggles[flag] or Library.Flags[flag] or Library.Items[flag] do
        flag = base .. "_" .. suffix
        suffix = suffix + 1
    end
    _usedControlFlags[flag] = true
    return flag
end

local function _callback(cfg)
    local cb = cfg and (cfg.Callback or cfg.Func)
    if type(cb) ~= 'function' then return nil end
    local name = tostring((cfg and (cfg.Name or cfg.Flag)) or 'unnamed')
    return function(...)
        local args = table.pack(...)
        local ok, err = xpcall(function() cb(table.unpack(args, 1, args.n)) end, debug.traceback)
        if not ok then warn('[TW 2.5 callback] ' .. name .. ' | ' .. tostring(err)) end
    end
end

local function _toKeyCode(v)
    if typeof(v) == 'EnumItem' then return v end
    if type(v) == 'string' then
        if v == 'None' or v == '' then return Enum.KeyCode.Unknown end
        return Enum.KeyCode[v] or Enum.KeyCode.Unknown
    end
    return Enum.KeyCode.Unknown
end

local function _safeCreate(container, text, fn)
    local ok, obj = pcall(fn)
    if ok then return obj end
    warn('[TW 2.5 UI] skipped: ' .. tostring(text) .. ' | ' .. tostring(obj))
    return nil
end

local function _wrapBlock(section)
    local out = {}
    section = section or {}

    function out:CreateToggle(cfg)
        cfg = cfg or {}
        local flag = _flag(cfg)
        local cb = _callback(cfg)
        local togCb = function(value, ...)
            if type(SetToggleState) == 'function' then SetToggleState(flag, value == true) end
            if cb then cb(value, ...) end
        end
        local obj = _safeCreate(section, cfg.Name or flag, function()
            return section:AddToggle({
                Name = cfg.Name or flag, Default = cfg.Default == true,
                Flag = flag, Callback = togCb,
            })
        end)
        if obj then
            Library.Toggles[flag] = obj
            Library.Flags[flag]   = obj
            Library.Items[flag]   = obj
        end
        return obj
    end

    function out:CreateSlider(cfg)
        cfg = cfg or {}
        local flag = _flag(cfg)
        local cb = _callback(cfg)
        local inc = 1
        if cfg.Rounding and cfg.Rounding > 0 then inc = 1 / math.pow(10, cfg.Rounding) end
        local obj = _safeCreate(section, cfg.Name or flag, function()
            return section:AddSlider({
                Name = cfg.Name or flag,
                Default = cfg.Default ~= nil and cfg.Default or (cfg.Min or 0),
                Min = cfg.Min or 0, Max = cfg.Max or 100,
                Increment = inc, ValueName = cfg.Suffix or '',
                Flag = flag, Callback = cb,
            })
        end)
        if obj then Library.Options[flag] = obj; Library.Items[flag] = obj end
        return obj
    end

    function out:CreateDropdown(cfg)
        cfg = cfg or {}
        local flag = _flag(cfg)
        local values = cfg.Items or cfg.Values or cfg.List or {'Select...'}
        if type(values) ~= 'table' or #values == 0 then values = {'Select...'} end
        local cb = _callback(cfg)
        local obj = _safeCreate(section, cfg.Name or flag, function()
            return section:AddDropdown({
                Name = cfg.Name or flag, Options = values,
                Default = cfg.Default, Flag = flag, Callback = cb,
            })
        end)
        if obj then Library.Options[flag] = obj; Library.Items[flag] = obj end
        return obj
    end

    function out:CreateButton(cfg)
        cfg = cfg or {}
        local text = cfg.Name or cfg.Text or 'Button'
        local cb = _callback(cfg) or function() end
        return _safeCreate(section, text, function()
            return section:AddButton({Name = text, Callback = cb})
        end)
    end

    function out:CreateInput(cfg)
        cfg = cfg or {}
        local flag = _flag(cfg)
        local cb = _callback(cfg)
        local obj = _safeCreate(section, cfg.Name or flag, function()
            return section:AddTextbox({
                Name = cfg.Name or flag, Default = cfg.Default or '',
                TextDisappear = cfg.TextDisappear or false,
                Flag = flag, Callback = cb,
            })
        end)
        if obj then Library.Options[flag] = obj; Library.Items[flag] = obj end
        return obj
    end

    function out:CreateKeybind(cfg)
        cfg = cfg or {}
        local flag = _flag(cfg)
        local keyCode = _toKeyCode(cfg.Default or 'None')
        local cb = _callback(cfg)
        local obj = _safeCreate(section, cfg.Name or flag, function()
            return section:AddBind({
                Name = cfg.Name or flag, Default = keyCode,
                Save = true, Flag = flag, Callback = cb,
            })
        end)
        if obj then Library.Options[flag] = obj; Library.Items[flag] = obj end
        return obj
    end

    function out:CreateColorPicker(cfg)
        cfg = cfg or {}
        local flag = _flag(cfg)
        local cb = _callback(cfg)
        if type(section.AddColorPicker) ~= 'function' then
            return out:CreateLabel({Name = cfg.Name or flag})
        end
        local obj = _safeCreate(section, cfg.Name or flag, function()
            return section:AddColorPicker({
                Name = cfg.Name or flag, Default = cfg.Default or Color3.new(1,1,1),
                Flag = flag, Callback = cb,
            })
        end)
        if obj then Library.Options[flag] = obj; Library.Items[flag] = obj end
        return obj
    end

    function out:CreateLabel(cfg)
        local obj = {}
        function obj:SetText() end
        function obj:Set() end
        return obj
    end
    function out:CreateImage(cfg) return out:CreateLabel(cfg) end
    function out:CreateTabbox(cfg)
        local tabs = {}
        function tabs:CreateTab() return out end
        return tabs
    end
    return out
end

local _rawMakeWindow = Library.MakeWindow
Library.CreateWindow = function(self, cfg)
    cfg = cfg or {}
    local window = _rawMakeWindow(self, {
        Name = cfg.Title or 'The Worst 2.5',
        SubNameSide = 'Center', ShowIcon = true, Icon = 'crown',
        IntroEnabled = false,
