local Actions = {}

function Actions.Grab(part, cf)
    local _, hrp, hum = Char()
    if not hrp or not hum or hum.Health == 0 or not part or not part.Parent then return end
    local target = (cf or hrp.CFrame) * CFrame.new(0, 1.593, 0)
    local aimed  = part.CFrame
    if not State.Toggles.DirectGrab then
        aimed = CFrame.new(target.Position, aimed.Position)
    end
    if RemoteCache.SetNetworkOwner then
        RemoteCache.SetNetworkOwner:FireServer(part, aimed)
    end
end

function Actions.RNO(part)
    if RemoteCache.DestroyGrabLine then
        RemoteCache.DestroyGrabLine:FireServer(part)
    end
end

function Actions.ResetVelocity(part)
    if not part or not part:IsA("BasePart") then return end
    if part.AssemblyAngularVelocity ~= Vector3.zero then part.AssemblyAngularVelocity = Vector3.zero end
    if part.AssemblyLinearVelocity  ~= Vector3.zero then part.AssemblyLinearVelocity  = Vector3.zero end
end

function Actions.Teleport(part, cf, noReset)
    if not part or not part:IsA("BasePart") or not cf then return end
    if typeof(cf) == "Vector3" then cf = CFrame.new(cf) end
    if typeof(cf) ~= "CFrame" then return end
    part.CFrame = cf
    if noReset ~= false then Actions.ResetVelocity(part) end
end

function Actions.SNO(part, timeout, cond)
    local _, hrp, hum = Char()
    if not hrp or not hum or hum.Health == 0 or not part or not part.Parent then return false end
    if IsPartOwner(part) then return true end
    local start = tick()
    timeout = timeout or 0.65
    while not IsPartOwner(part) and part.Parent and hum.Health > 0 and hrp.Parent and (tick() - start) < timeout do
        if cond and not cond() then return false end
        Actions.Grab(part)
        RunService.Heartbeat:Wait()
    end
    return IsPartOwner(part)
end

function Actions.BreakLimb(player, mode)
    local char, hrp, hum = Char(player)
    if not hrp or not hum or hum.Health == 0 then return end
    local ragdolled = hum:FindFirstChild("Ragdolled")
    if not ragdolled then return end

    if player == LocalPlayer then
        if RemoteCache.RagdollRemote then RemoteCache.RagdollRemote:FireServer(hrp, 0.35) end
        task.wait(0.2)
    else
        if not Actions.SNO(hrp) then return end
        if RemoteCache.RagdollRemote then RemoteCache.RagdollRemote:FireServer(hrp, 0) end
        task.wait(0.15)
    end

    local cf = hrp.CFrame
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            if part.Name:find("Arm") and (mode == "Arms" or mode == "All") then
                Actions.Teleport(part, CFrame.new(0, -100000, 0))
            elseif part.Name:find("Leg") and (mode == "Legs" or mode == "All") then
                Actions.Teleport(part, CFrame.new(0, -100000, 0))
            end
        end
    end
    task.wait(0.15)
    if not hrp.Parent then return end
    Actions.Grab(hrp)
    task.wait(0.2)
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then Actions.ResetVelocity(part) end
    end
end

function Actions.Kill(player)
    local char, hrp, hum = Char(player)
    if not hrp or not hum or hum.Health == 0 then return end
    hum.BreakJointsOnDeath = false
    hum:ChangeState(Enum.HumanoidStateType.Dead)
    if not Actions.SNO(hrp) then return end
    workspace.FallenPartsDestroyHeight = -10000
    Actions.Teleport(hrp, CFrame.new(0, -11000, 0))
    task.wait(0.1)
    workspace.FallenPartsDestroyHeight = -100
end

function Actions.Void(player)
    local char, hrp, hum = Char(player)
    if not hrp or not hum or hum.Health == 0 then return end
    if not Actions.SNO(hrp) then return end
    Actions.Teleport(hrp, CFrame.new(0, 9e9, 0))
    hrp.Velocity = Vector3.new(0, 9e9, 0)
    task.delay(0.35, Actions.RNO, hrp)
end

function Actions.BringPlayer(player)
    local _, hisRoot, hisHum = Char(player)
    local _, myRoot, myHum = Char()
    if not (hisRoot and hisHum and hisHum.Health > 0 and myRoot and myHum and myHum.Health > 0) then return end
    if not IsNetworkOwner(hisRoot) and not Actions.SNO(hisRoot) then return end
    local targetCF = myRoot.CFrame * CFrame.new(0, 0, -5)
    for _ = 1, 3 do
        if not hisRoot.Parent or hisHum.Health <= 0 then break end
        hisRoot.CFrame = targetCF
        Actions.ResetVelocity(hisRoot)
        RunService.Heartbeat:Wait()
    end
    Actions.RNO(hisRoot)
end

function Actions.RemoveGucci(player)
    local _, hrp, hum = Char(player)
    if not hrp or not hum or hum.Health == 0 then return end
    if hum.Sit then hum.Sit = false end
    if not Actions.SNO(hrp) then return end
    hum.Sit = true
    task.wait(0.1)
    hum.Sit = false
    task.wait(0.1)
    Actions.Grab(hrp)
end

function Actions.DestroyObject(model, part)
    if not model or not model:IsA("Model") then return end
    part = part or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not part or part.Anchored or not Actions.SNO(part) then return end
    Actions.RNO(part)
    workspace.FallenPartsDestroyHeight = 0/0
    model:PivotTo(CFrame.new(0, -11111, 0))
    task.delay(0.2, function()
        workspace.FallenPartsDestroyHeight = -100
        task.delay(0.4, Actions.RNO, part)
    end)
end

-- ============================================
-- Loop Engine
-- ============================================
local LoopTokens = {}
local Loops = {}

local function processPlayer(player, loop, isServer, isBlob, tokenId)
    if not player or not player.Parent then return end
    if isBlob then
        local method = State.Values.BlobMethod
        if method == "Kill" then
            Actions.Kill(player)
        elseif method == "Bring" then
            Actions.BringPlayer(player)
        elseif method == "Remove Gucci" then
            Actions.RemoveGucci(player)
        elseif method == "Follow" then
            local _, hisRoot, hisHum = Char(player)
            local _, myRoot, myHum = Char()
            if hisRoot and hisHum and hisHum.Health > 0 and myRoot then
                while isServer and tokenId == LoopTokens[tokenId] and hisHum.Health > 0 do
                    if (hisRoot.Position - myRoot.Position).Magnitude > 50 then
                        Actions.Teleport(hisRoot, myRoot.CFrame * CFrame.new(0, 5, 0))
                    end
                    task.wait()
                end
            end
        elseif method == "Lock" and RemoteCache.SpawnToy then
            -- stub: ต้องใช้ blobman seat
        elseif method == "Kick" and isServer then
            -- KickServer
            local targets = {}
            for p in pairs(Lists.Blobman) do
                if p.Parent and p ~= LocalPlayer and not IsProtectedPlayer(p) then
                    table.insert(targets, p)
                end
            end
            for _, p in ipairs(targets) do
                local _, hp, hh = Char(p)
                if hp and hh and hh.Health > 0 then
                    Actions.Kill(p)
                end
            end
        end
        return
    end

    if State.TargetMethods.Bring then Actions.BringPlayer(player) end
    if State.TargetMethods.Kill  then Actions.Kill(player) end
    if State.TargetMethods.Void  then Actions.Void(player) end
    if State.TargetMethods["Remove Gucci"] then Actions.RemoveGucci(player) end
    if State.TargetMethods["Delete Limbs"] then
        Actions.BreakLimb(player, State.Values.TargetedLimbTE)
    end
end

local function startLoop(name, server, blob, listRef)
    LoopTokens[name] = (LoopTokens[name] or 0) + 1
    local myToken = LoopTokens[name]

    task.spawn(function()
        while State.Toggles[name] and LoopTokens[name] == myToken do
            local targets = {}
            for p in pairs(listRef) do
                if p and p.Parent and p ~= LocalPlayer and not IsProtectedPlayer(p) then
                    table.insert(targets, p)
                end
            end
            for _, p in ipairs(targets) do
                if not State.Toggles[name] or LoopTokens[name] ~= myToken then break end
                pcall(processPlayer, p, true, server, blob, myToken)
            end
            task.wait(0.1)
        end
    end)
end

