local function LoadLibrary()
    local ok, result = pcall(function()
        local src = game:HttpGet("https://raw.githubusercontent.com/ludicious-claw/BetterOrion/refs/heads/main/Library.lua")
        local chunk = loadstring(src)
        return chunk and chunk()
    end)
    if ok and type(result) == "table" then return result end

    local function Stub()
        local t = {}
        setmetatable(t, { __index = function(self, key)
            local fn = function() return self end
            rawset(self, key, fn); return fn
        end })
        return t
    end
    return {
        Flags = {}, MakeNotification = function() end, Destroy = function() end,
        SetConfigTab = function() end, LoadAutoloadConfigs = function() end,
        SaveAndLoadSizes = function() end, Init = function() end,
        Set = function() end, Save = function() end, Get = function() return nil end,
        MakeWindow = function() local w = Stub(); w.MakeTab = function() return Stub() end; return w end,
    }
end

