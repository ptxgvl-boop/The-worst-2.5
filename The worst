-- ============================================
-- Helpers: Player Dropdowns
-- ============================================
local function makePlayerDropdown(section, name, listRef, multi, onChanged)
    if multi == nil then multi = true end

    local options = { "None" }
    local function refresh()
        options = { "None" }
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                table.insert(options, p.DisplayName .. " (@" .. p.Name .. ")")
            end
        end
    end
    refresh()

    local dd = section:AddDropdown({
        Name = name,
        Options = options,
        Default = multi and {} or "None",
        Multi = multi,
        Flag = "Resonance_" .. name .. "_" .. tostring(math.random(1, 1e6)),
        Callback = function(sel)
            for k in pairs(listRef) do listRef[k] = nil end
            local function resolveKey(v)
                if type(v) ~= "string" then return nil end
                local n = v:match("@([^%)]+)")
                if n then return Players:FindFirstChild(n) end
                return Players:FindFirstChild(v)
            end
            if multi then
                for _, v in ipairs(sel) do
                    local p = resolveKey(v)
                    if p and not IsProtectedPlayer(p) then listRef[p] = true end
                end
            else
                local p = resolveKey(sel)
                if p and not IsProtectedPlayer(p) then listRef[p] = true end
            end
            if onChanged then onChanged() end
        end,
    })

    -- Auto-refresh on join/leave
    Players.PlayerAdded:Connect(function()
        refresh()
        if dd and dd.RefreshOptions then dd:RefreshOptions(options) end
    end)
    Players.PlayerRemoving:Connect(function(p)
        listRef[p] = nil
        refresh()
        if dd and dd.RefreshOptions then dd:RefreshOptions(options) end
    end)

    return dd
end

