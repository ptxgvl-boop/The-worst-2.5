function StyleMenuUI()
    local player     = game:GetService("Players").LocalPlayer
    local playerGui  = player:WaitForChild("PlayerGui")
    local menuGui    = playerGui:WaitForChild("MenuGui")
    local menu       = menuGui:WaitForChild("Menu")

    local black      = Color3.fromRGB(8, 10, 16)
    local dark       = Color3.fromRGB(18, 16, 14)
    local gold       = Color3.fromRGB(255, 215, 0)
    local goldLight  = Color3.fromRGB(255, 235, 150)
    local goldDark   = Color3.fromRGB(200, 160, 0)
    local cornerRadius = UDim.new(0, 12)

    local function roundCorners(obj)
        local c = obj:FindFirstChildOfClass("UICorner") or Instance.new("UICorner", obj)
        c.CornerRadius = cornerRadius
    end
    local function addGoldGradient(obj, rotation)
        local g = obj:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
        g.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, goldDark),
            ColorSequenceKeypoint.new(0.2, goldLight),
            ColorSequenceKeypoint.new(0.5, gold),
            ColorSequenceKeypoint.new(0.8, goldLight),
            ColorSequenceKeypoint.new(1, goldDark)
        }
        g.Rotation = rotation or 45
        g.Parent = obj
    end
    local function addGoldStroke(obj, thickness, transparency)
        local s = obj:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
        s.Color = gold; s.Thickness = thickness or 1.5; s.Transparency = transparency or 0.5
        s.Parent = obj
        return s
    end

    local tabBar = menu:WaitForChild("TabBar")
    tabBar.BackgroundColor3 = black
    tabBar.BackgroundTransparency = 0.2
    tabBar.Size = UDim2.new(tabBar.Size.X.Scale, tabBar.Size.X.Offset, 0.9999, tabBar.Size.Y.Offset)
    roundCorners(tabBar); addGoldStroke(tabBar, 1, 0.6)

    for _, frame in ipairs(menu:WaitForChild("TabContents"):GetChildren()) do
        if frame:IsA("Frame") then
            frame.BackgroundColor3 = black
            frame.BackgroundTransparency = 0.65
            roundCorners(frame); addGoldStroke(frame, 1, 0.4)

            local title = frame:FindFirstChild("Title")
            if title then
                title.BackgroundColor3 = dark; title.BackgroundTransparency = 0.3
                roundCorners(title); addGoldStroke(title, 1, 0.3)
                title.Size = UDim2.new(title.Size.X.Scale * 0.975, title.Size.X.Offset, title.Size.Y.Scale, title.Size.Y.Offset)
                local tg = title:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
                tg.Color = ColorSequence.new{
                    ColorSequenceKeypoint.new(0, goldDark),
                    ColorSequenceKeypoint.new(0.5, goldLight),
                    ColorSequenceKeypoint.new(1, goldDark)
                }
                tg.Rotation = 90; tg.Parent = title
            end

            local st = frame:FindFirstChild("SortingTabs")
            if st then
                st.BackgroundColor3 = dark; st.BackgroundTransparency = 0.4
                roundCorners(st); addGoldStroke(st, 1, 0.3)
            end

            local contents = frame:FindFirstChild("Contents")
            if contents then
                contents.BackgroundColor3 = Color3.fromRGB(25, 22, 18)
                contents.BackgroundTransparency = 0.5
                roundCorners(contents); addGoldGradient(contents, 45); addGoldStroke(contents, 1.5, 0.3)
            end

            local fav = frame:FindFirstChild("FavoritesFrame")
            if fav then
                fav.BackgroundColor3 = black; fav.BackgroundTransparency = 0.8
                roundCorners(fav); addGoldStroke(fav, 1, 0.3)
            end
        end
    end
end
StyleMenuUI()

